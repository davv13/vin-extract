# Copy to .env and adjust as needed

APP_NAME=VIN Extract API
APP_VERSION=1.0.0
DEBUG=false

# Accept VIN when confidence >= this value (0–1). Default 80%.
# Below threshold → return immediately (NO OCR re-run).
CONFIDENCE_THRESHOLD=0.80

OCR_BACKEND=paddle

# Speed-oriented PP-OCRv5 setup (target ~under 10s on CPU)
PADDLE_LANG=en
PADDLE_OCR_VERSION=PP-OCRv5
PADDLE_DET_MODEL=PP-OCRv5_mobile_det
PADDLE_REC_MODEL=en_PP-OCRv5_mobile_rec
PADDLE_DEVICE=cpu
PADDLE_USE_DOC_ORIENTATION=false
PADDLE_USE_TEXTLINE_ORIENTATION=true
PADDLE_ENABLE_MKLDNN=false

EASYOCR_LANGS=en
EASYOCR_GPU=false

MAX_UPLOAD_MB=15
ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/bmp,image/tiff
CORS_ORIGINS=*
